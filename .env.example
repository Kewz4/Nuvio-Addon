# Required to create private, encrypted configuration links in the web UI.
# Use a long random value and keep it unchanged after deployment.
CONFIG_SECRET=replace-with-at-least-32-random-characters

# Optional: configure one fixed personal add-on at /manifest.json.
# Paste the complete configured manifest URL for each provider.
PROGRESO_LATINO_URL=
PEERFLIX_URL=
COMETA_URL=
MEDIAFUSION_URL=
LATINO_PROVIDERS_PLUGIN_URL=

# Optional: override the bundled public TMDB key used for Spanish metadata.
TMDB_API_KEY=

# Optional deployment settings.
PORT=7000
# PUBLIC_BASE_URL=https://your-domain.example
# UPSTREAM_TIMEOUT_MS=12000
# CACHE_TTL_MS=60000
# CINEMETA_CATALOG_CACHE_TTL_MS=1800000
# CINEMETA_META_CACHE_TTL_MS=21600000
# ALLOW_PRIVATE_UPSTREAMS=false
